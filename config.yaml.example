# ============================================================
# evoref 設定ファイル テンプレート
# ============================================================
# このファイルを config.yaml にコピーして、環境に合わせて編集してください。
#   cp config.yaml.example config.yaml
#
# 詳細は docs/02_system_architecture.md セクション 2.3 を参照。
# ============================================================

# ===== 個体名称 =====
# PC単位で動作する個体としての設定。
# 名前はシステムプロンプト・UI・CLIに反映される。
instance:
  name: evoref                    # このPC上のアシスタントの名前（自由に設定可）
  # 例: name: アリス / name: Jarvis / name: evo-work

# ===== サーバー設定 =====
server:
  host: 0.0.0.0
  port: 8000                      # FastAPI バックエンドのポート
  frontend_port: 5173             # SvelteKit 開発サーバーのポート
  timeout: 30                     # リクエストタイムアウト（秒）

# ===== 実行環境 =====
# GPU / CPU 等、llama-server 群を起動するハードウェアの制約を表現する。
# `scripts/launch_llama.py --all` が参照し、GPU オフロード対象モデルの
# VRAM 使用量推定合計がこの予算を超える場合は警告してアボートする。
# `--force` オプションで強制起動可能。main.py lifespan でも起動時に
# GPU/CPU 配置サマリを INFO ログに出力する。
runtime:
  # VRAM のソフト上限 (MB)。null なら検査を行わない (従来挙動と同一)。
  # 例: RTX 3060 (12GB) → 11000 程度、RTX 4060 Ti (8GB) → 7000 程度が目安。
  total_vram_budget_mb: null

  # llama-server の最低 build 番号。null なら検査を行わない
  # 形式: "b<整数>" (例: "b8946") または "<整数>" (例: "8946")。
  # b8946 は CVE-2026-21869 (server: heap-buffer-overflow on negative
  # n_discard) と SWA-full ロジック修正を取り込んだ最低ビルド。
  # `scripts/launch_llama.py` 起動時に `llama-server --version` を実行し、
  # 抽出した build 番号と比較する。検出失敗時 (カスタムビルド等) は警告のみ。
  min_llamacpp_build: "b8946"
  # true の場合、最低 build 未満を検出すると exit code 3 でアボート。
  # false の場合は stderr 警告のみで起動継続。
  enforce_min_llamacpp_build: false

  # llama-fit-params -fitp on ベースの Tier 1 VRAM 推定
  # ``--fit-print on`` で device 別の使用 MiB (model / context / compute) を
  # stdout に出力する。本フラグが true で同バイナリが利用可能なら、モデル
  # 単位で正確な VRAM 推定値が得られる。バイナリ未存在 / タイムアウト時は
  # 自動的に Tier 2 (GGUF サイズベースのヒューリスティック) にフォールバック
  # するため、PATH に通っていなくても従来通り動作する。
  fit_params_enabled: true              # false で Tier 1 を一律スキップ
  fit_params_timeout_sec: 10.0          # 1 モデルあたりの subprocess タイムアウト秒数
  fit_params_binary: "llama-fit-params" # PATH 上のコマンド名または絶対パス

  # llama-server エンドポイント利用ポリシー宣言
  # "oai-only" (既定) で OpenAI 互換 (/v1/chat/completions / /v1/embeddings /
  # /tokenize / /health / /props) のみ採用、
  # "messages-allowed" は将来 /v1/messages 採用判断を行った場合の予約値。
  # 実体の検証は backend/free/tests/test_llama_endpoint_policy.py の静的検査
  # で担保する。詳細 docs/e_05_llama_server_endpoint_policy.md。
  llama_endpoint_policy: "oai-only"

  # モデル接続/切替時に実挙動プローブを実行し、宣言と実機の食い違いを観測して
  # 処理を自動適応するか。true (既定) でバックグラウンド実行 (起動遅延なし)。
  # プローブ失敗時は prior (プロファイル宣言) にフォールバック。
  # 詳細 docs/c_15_model_capability_adaptation.md。
  capability_probe: true

  # llama.gpu_layers / assist_model.local.gpu_layers が "auto" の場合に
  # GPU 物理容量から差し引く Vulkan host buffer 予約量 (MiB)。
  # iGPU 環境で embed (CPU モード) が起動時に確保する pinned buffer 用
  # の余裕。既定 4 GiB は AMD Radeon 890M + 既定の embed モデル構成での
  # 実測 ceiling。dedicated GPU でメモリに余裕があれば 0 にしても良い。
  vulkan_host_buffer_headroom_mib: 4096

  # gpu_layers="auto" 時に実際に自動段階縮小を行う kill switch。
  # false にすると "auto" 指定があっても従来挙動 (-ngl 999) にフォールバックし
  # WARNING ログを 1 行出す。GGUF parse や llama-fit-params に異常が出た場合の
  # 緊急回避用。
  gpu_auto_tune_enabled: true

# ===== llama.cpp 設定 =====
# llama-server の起動オプション。scripts/launch_llama.py が読み込む。
#
# --- VRAM 見積もり目安（Qwen3.5-9B Q4_K_M, slots=2）---
# | context_size | cache K/V | KVキャッシュ概算 | モデル+KV 合計 |
# |-------------|-----------|----------------|--------------|
# |       4,096 | q8_0/q8_0 |       ~512 MB  |    ~3.2 GB   |
# |       8,192 | q8_0/q8_0 |      ~1024 MB  |    ~3.7 GB   |
# |       8,192 | q4_0/q4_0 |       ~512 MB  |    ~3.2 GB   |
# |      16,384 | q4_0/q4_0 |      ~1024 MB  |    ~3.7 GB   |
# |      16,384 | q8_0/q4_1 |      ~1280 MB  |    ~4.0 GB   |  ← K/V非対称
# |      32,768 | q4_0/q4_0 |      ~2048 MB  |    ~4.7 GB   |  ← slots:1推奨
#
# --- 長コンテキスト設定レシピ ---
# ■ 8K コンテキスト（VRAM 4GB〜）:
#   context_size: 8192, cache_type_k: q8_0, cache_type_v: q8_0
#
# ■ 16K コンテキスト（VRAM 6GB〜）:
#   context_size: 16384, cache_type_k: q8_0, cache_type_v: q4_1, slots: 1
#   extra_args: ["--rope-scaling", "linear", "--rope-scale", "4"]
#   ※ モデルの学習時コンテキスト長を超える場合は RoPE スケーリングが必要
#
# ■ 32K コンテキスト（VRAM 8GB〜）:
#   context_size: 32768, cache_type_k: q4_1, cache_type_v: q4_0, slots: 1
#   extra_args: ["--rope-scaling", "yarn", "--rope-scale", "8"]
#   ※ YaRN は linear より長距離で安定。品質はモデル依存
llama:
  host: localhost
  port: 8080                      # llama-server のポート
  context_size: 8192              # -c / コンテキストサイズ
                                  # 推奨: 4096〜8192（VRAM に応じて調整）
                                  # 4096 だと fetch_url の長い結果 (Yahoo / news 等) で
                                  # ツール結果 + RAG + system prompt が context を超過するため、
                                  # 既定を 8192 に引き上げ。VRAM 余裕があれば 16384 以上も可。
                                  # 16384以上は cache_type の見直し + RoPE スケーリングを検討
                                  # モデルの学習時コンテキスト長は GET /props の n_ctx_train で確認可能
                                  # null にすると arch プロファイル (models/profiles/<arch>.yaml の
                                  # context_size) を使用。明示 int は常にプロファイルより優先される
                                  # (解決順: ここの明示値 > profile > 8192)
  gpu_layers: 999                 # -ngl / GPU にオフロードするレイヤー数（999=全層、CPU only なら 0）
  threads: 0                      # -t / スレッド数（0=自動検出）
  batch_size: 512                 # -b / バッチサイズ
  flash_attn: true                # -fa / Flash Attention の有効化
  mlock: false                    # --mlock / モデルを RAM に固定
  cache_prompt: true              # KVキャッシュ再利用（共通プレフィックスの再計算をスキップ）
  slots: 1                        # -np / 並列スロット数（1=単一, 2=チャット+バックグラウンド分離）
                                  # 1: VRAM 節約（KV キャッシュ半減）が既定。チャットとバックグラウンド
                                  #    処理が 1 スロットを共有・直列化する
                                  # 2: チャットとバックグラウンド処理の KV キャッシュを分離（VRAM 余裕時）
  cache_type_k: q8_0              # --cache-type-k / KV key 量子化
                                  #   f16: 基準（VRAM最大）, bf16: bf16学習モデル向け
                                  #   q8_0: 推奨（VRAM半減、品質劣化ほぼゼロ）
                                  #   q5_1/q5_0: 中間（VRAM 65-70%削減）
                                  #   q4_1: q4_0より高品質, q4_0: 最大圧縮（品質モデル依存）
                                  #   ※ K は V より量子化に敏感。K: q8_0 / V: q4_1 の非対称設定も有効
  cache_type_v: q8_0              # --cache-type-v / KV value 量子化（選択肢は cache_type_k と同一）
  cache_reuse: 256                # --cache-reuse / 共通 prefix 自動再利用（0=無効）。多ターン chat の prefill コスト削減。
                                  #   ⚠️ SWA モデル（gemma-4 等）では llama.cpp が自動無効化し no-op（毎ターン full re-prefill）。非 SWA base のみ有効
  max_tokens: 1024                # チャット応答の最大トークン数（0=無制限、暴走防止に設定推奨）
  lora_target: auto               # LoRA ターゲット自動判定: auto | "q_proj,v_proj" | "linear_proj" 等（Pro 専用）
  enable_thinking: false          # 思考トークン制御。true/false=明示（プロファイルを上書き）
                                  # 未設定/コメントアウト時は arch プロファイル (models/profiles/<arch>.yaml)
                                  # の reasoning.mode/enable_thinking で決定。
                                  # mode=toggle のみ enable_thinking を送信。mode=always(常時思考・OFF不可)/
                                  # none(非対応) の arch には enable_thinking を送らない (HTTP 400 回避)
  stream_first_token_timeout_sec: 60.0  # SSE 受信開始までの read timeout (秒)
                                  # llama-server 再起動直後の冷えた KV キャッシュ + 長プロンプトで
                                  # prefill が長引く環境 (iGPU 等) では 90〜120 に引き上げる。
  # --- idle slot offload ---
  # cache_ram_mib: -1=無制限 / 0=disable / >0=MiB 上限 (host RAM 退避量。VRAM 非依存)
  #   上流デフォルト 8192 を黙従しないよう launch_llama.py が常に明示付与する。
  #   既定 slots=1 では退避対象の idle slot が存在しないため 0 で無効化し
  #   host RAM 予約を省く。slots を 2 以上にしても per-seq context は kv_unified
  #   (下記) が守るので、cache_ram_mib は RAM 退避が欲しい時のみ >0 にすればよい。
  # cache_idle_slots: 上流既定 true (idle slot を退避対象にする)。
  #   false で機構自体を OFF（``--no-cache-idle-slots`` 付与）。
  # kv_unified: null=auto (slots>1 で ``--kv-unified`` 自動付与) / true|false で明示上書き。
  #   非 unified だと per-seq context が n_ctx/slots に半減する (-c 8192 -np 2 で 4096)。
  #   unified は VRAM 増なしに各 seq へ full n_ctx を与える。cache_ram_mib とは独立。
  cache_ram_mib: 0
  cache_idle_slots: true
  kv_unified: null
  # --- self-speculative decoding ---
  # Pro 限定。``evoref code`` モード (Pro デフォルト) の base モデルで
  # コーディング系ワークロードのスループット改善を狙う。Free では
  # ``enabled=true`` でも launch_llama.py 側で warning + 無効化される。
  # mode の意味:
  #   "default":      ``--spec-default`` 単独 (上流プリセット ngram-mod, n=24, min=48, max=64)
  #   "ngram-mod" /
  #   "ngram-cache" /
  #   "ngram-simple" /
  #   "ngram-map-k" /
  #   "ngram-map-k4v": self-speculative ngram 系 (draft モデル不要)
  #   "draft-model":   外部 draft モデル経路 (``draft_model_path`` 必須)
  speculative:
    enabled: false                # Pro でも opt-in
    mode: default                 # default | ngram-mod | ngram-cache | ngram-simple | ngram-map-k | ngram-map-k4v | draft-model
    draft_max: 64                 # ``--draft-max`` (1 サイクルの最大 draft トークン数)
    draft_min: 48                 # ``--draft-min``
    draft_p_min: null             # ``--draft-p-min`` (greedy 採択の確率閾値、null=未指定)
    ctx_size_draft: 0             # ``-cd`` (0 = model から取得、上流既定)
    ngram_size_n: 24              # ``--spec-ngram-size-n``
    ngram_size_m: null            # ``--spec-ngram-size-m`` (null=未指定)
    # mode="draft-model" 時のみ使用
    draft_model_path: null        # 外部 draft GGUF パス (相対 / 絶対)
    gpu_layers_draft: null        # ``-ngld`` (null=auto, 整数, "all" を許容)
  # --- MTP (Multi-Token Prediction) self-speculative ---
  # Free/Pro 共通。モデル内蔵の MTP ヘッド (NextN 層) を draft に使う自己投機で、
  # 外部 draft モデル不要。MTP ヘッドを内蔵した GGUF (Qwen3.5/3.6 等) でのみ有効。
  # 非対応モデル (gemma-4 / lfm2 等) では launch_llama.py が warning を出して素通り。
  # speculative と同時 enabled の場合は MTP が優先され speculative は無効化される。
  # 起動フラグ: --spec-type draft-mtp + --spec-draft-n-max <draft_n_max>
  mtp:
    enabled: false                # 対応モデルで true にすると MTP を有効化
    draft_n_max: 3                # ``--spec-draft-n-max`` (1 サイクルの draft トークン数、上流既定 3)
  # モデル arch 別の起動フラグ / sampling 自動決定 (base / assist 共通)。
  # true: GGUF の general.architecture を読み、models/profiles/<arch>.yaml (同梱)
  #       ＋ local/profiles/<arch>.yaml (任意 override) から
  #       --jinja / --reasoning-format / MoE / sampling 既定を解決する。
  #       プロファイルの無い arch には何も付与しない。モデル切替時も自動再評価。
  # false: 本機構を完全 OFF にし、従来どおり extra_args 手動指定のみで運用する。
  auto_model_flags: true
  extra_args: []                  # 上記以外の任意オプションを文字列リストで追加 (auto_model_flags より優先)
  # --- RoPE スケーリング（モデルの学習時コンテキスト長を超える場合）---
  # linear: シンプル、短〜中距離向け
  #   例: ["--rope-scaling", "linear", "--rope-scale", "2"]  # context_size × 2
  # yarn: 長距離で安定、品質劣化が少ない
  #   例: ["--rope-scaling", "yarn", "--rope-scale", "4"]    # context_size × 4
  # ※ スケール倍率 = 目標コンテキスト長 ÷ モデルの学習時コンテキスト長

# ===== モード別生成パラメータ =====
# ベースモデル (= チャット用) + コーディング用モデル の 2 モデル構成。
# - chat: 常に model_paths.base_model を使用 (独立 model フィールド無し)
# - coding: 生成パラメータのみ。モデルパスは model_paths.coding_model に指定
modes:
  chat:
    temperature: 0.7                # 生成温度（0.0〜2.0）— 高いほど多様な応答
    top_p: 0.9                      # Top-P サンプリング（0.0〜1.0）
    top_k: 40                       # Top-K サンプリング（0=無効、1〜1000）
    presence_penalty: 0.0           # 存在ペナルティ（-2.0〜2.0）— 正で話題の多様性を促進
  coding:
    temperature: 0.3                # コーディングは低温度で正確性重視
    top_p: 0.95                     # やや高めで十分な候補を確保
    top_k: 20                       # 低めで的確なトークン選択
    presence_penalty: 0.0           # コーディングではペナルティなし

# ===== CLI 設定 =====
# CLI が FastAPI バックエンドに HTTP リクエストを送る際のタイムアウト (秒)。
# カートリッジ install/rebuild/create はサーバ側の処理時間が長い
# ため、default より大きい値を設定している。
cli:
  timeouts:
    default: 30                   # 一般的な GET/DELETE 系リクエスト
    install: 300                  # /cartridges/install (ベクトル化を含む)
    rebuild: 300                  # /cartridges/{id}/rebuild
    create: 600                   # /cartridges/create (チャンク生成 + 埋め込み)

# ===== テーマ設定 =====
# 統合テーマシステム（GUI + CLI 両対応）。詳細は docs/c_11_theme_system.md 参照。
theme:
  active: ''                      # 有効なテーマ ID（空文字列ならテーマ未適用、frontend 既定 CSS で描画）
  color_mode: dark                # dark / light
  trusted: []                     # 信頼済み外部テーマ ID リスト（slots / cli-modules を有効化したい ID を明示登録）
  cli_layout_mode: auto           # auto / split / sequential
                                  # auto: テーマの cli-theme.json に従う
                                  # split: 画面分割（上部スクロール出力 + 下部固定入力）
                                  # sequential: 従来の逐次出力

# ===== モデルパス =====
# GGUF モデルファイルのパス。
# 相対パスはプロジェクトルートからの相対、絶対パスはそのまま使用。
model_paths:
  base_model: models/gemma-4-12b-it-qat-q4_0.gguf    # ベース GGUF モデル（models/ に配置）
  assist_model: models/gemma-4-E4B_q4_0-it.gguf      # アシスト GGUF モデル（メモリ・RAG処理用）
  embed_model: models/Qwen3-Embedding-0.6B-Q8_0.gguf # 埋め込み用 GGUF モデル（llama-cpp バックエンド用）
  coding_model: null                                 # コーディングモード用 GGUF（null/空欄 = base_model にフォールバック）
  assist_coding_model: null                          # コーディングモード用アシスト GGUF（null/空欄 = assist_model にフォールバック）
                                                      # 設定すると /api/mode/switch が chat⇄coding 切替時に
                                                      # アシストサーバも非破壊的 (config.yaml 非変更) に差し替える

# ===== ベースモデル移行 / 起動時整合性チェック =====
model_migration:
  # true にすると local/model_state.json と model_paths.base_model の
  # ファイル名不一致を検出したとき RuntimeError で起動をブロックする。
  # false の場合は ERROR ログ + /api/model/state 経由で警告のみ。
  # ベースモデル切替は必ず /migrate-model 経由で行うこと。
  strict_startup_check: false
  # true にすると起動時 mismatch を検出した際に自動マイグレーションを
  # 実行する。LoRA アーカイブ・経験バッファ更新・
  # プロンプト meta / eval_core リセット・model_state.json 更新を一括実行。
  # auto_migrate と strict の両方を true にした場合は auto_migrate を
  # 優先し、失敗したときのみ RuntimeError で起動をブロックする。
  auto_migrate_on_startup: false

# ===== llama-server プロセス管理 =====
# enabled=true で lifespan 起動時に 3 種 (base/assist/embedding) の
# llama-server を自動 spawn し、`POST /api/model/{component}/migrate` 実行時に
# 自動再起動 + クライアント差し替えを行う。false (デフォルト) の場合は
# 従来通り `scripts/launch_llama.py` を別途実行するワークフロー互換。
process_manager:
  enabled: false           # 自動 spawn / 自動再起動を有効化
  health_timeout: 60       # 起動後ヘルスチェック待機時間 (秒)
  stop_timeout: 10         # SIGTERM 後のグレースフル終了待機時間 (秒)

# ===== ローカルパス（読み書き）=====
# データ・状態ファイルのパス。
# LocalPathsConfig は extra='forbid' のため、未定義キーや typo は起動時に
# ValidationError で検出される。
local_paths:
  themes_dir: local/themes/              # テーマパッケージディレクトリ
  # LoRA / アシスト LoRA / 埋め込み LoRA (Pro 限定機能 — Free では未使用だが PathResolver が参照する)
  lora_adapter: local/models/adapter.gguf                          # ベース LoRA アダプタ
  lora_versions_dir: local/lora_versions/                          # ベース LoRA スナップショット
  lora_archive_dir: local/lora_archive/                            # ベース LoRA アーカイブ (古い世代)
  assist_lora_adapter: local/models/assist_adapter.gguf            # アシスト LoRA アダプタ
  assist_lora_versions_dir: local/models/assist_lora_versions/     # アシスト LoRA スナップショット
  control_vector_adapter: local/models/control_vector.gguf            # base=C control vector 本体 (Pro)
  control_vector_versions_dir: local/models/control_vector_versions/  # control vector スナップショット (Pro)
  cvector_work_dir: local/cvector/                                 # control vector 生成の positive/negative 作業用 (Pro)
  embed_lora_adapter: local/models/embed_adapter.gguf              # 埋め込み LoRA アダプタ
  embed_lora_versions_dir: local/models/embed_lora_versions/       # 埋め込み LoRA スナップショット
  # RAG / メモリ
  vectors_dir: local/vectors/                # RAG ベクトルインデックス
  knowledge_dir: local/knowledge/            # RAG 用ソースドキュメント
  memory_dir: local/memory/                  # メモリシステム永続化
  prompts_dir: local/prompts/                # モード別システムプロンプト
  cartridges_dir: local/cartridges/          # カートリッジ（パッケージ + 埋め込み）
  history_dir: local/history/                # 会話履歴アーカイブ
  triggers_dir: local/triggers/              # EvorefMem トリガ辞書の user override 先 (任意、空ディレクトリで可)
  coding_workspace_dir: local/coding/        # staged コーディングの一時ワークスペース (spec/code/test 中間成果物 + manifest)
  # 学習・経験・状態
  learning_dir: local/learning/                      # base 学習データの (モデル×モード) パーティションルート (learning.partition_by_base_model=true 時に使用)
  experience_file: local/experience.json             # ベースモデル経験バッファ
  experience_assist_file: local/experience_assist.json   # アシストモデル経験バッファ
  eval_core_file: local/eval_core.json               # ベースモデル コア評価セット
  eval_assist_file: local/eval_assist.json           # アシストモデル コア評価セット
  assist_calibration_file: local/assist_calibration.json # アシスト purpose 別 timeout の反応的自己較正値 (モデル切替後に自動調整)
  learned_patterns_file: local/learned_patterns.json # 学習済みパターン検出キーワード
  model_state_file: local/model_state.json           # モデル切替・LoRA 装着状態の永続化
  local_state_file: local/state.json                 # EvorefMem ローカル状態
  # マイグレーション
  migration_archive_dir: local/migration_archive/    # SchemaMigrator バックアップ / 旧 prompts 退避先 (EvorefMem 移行で 30 日保持)

# ===== 会話履歴設定 =====
history:
  auto_save: true                 # 自動保存の有効/無効
  checkpoint_interval: 10         # チェックポイント間隔（ターン数）
  retention_full_days: 90         # 原文保持期間（日）
  retention_compressed_days: 365  # 圧縮保持期間（日）
  max_storage_mb: 200             # 履歴全体の上限サイズ（MB）
  compress_preview_chars: 100     # 圧縮時に保持するアシスタントターンの先頭文字数
  summary_batch_size: 5           # sleep-time での要約生成バッチサイズ

# ===== RAG 設定 =====
rag:
  chunk_size: 512                 # チャンクサイズ（トークン数）
  chunk_overlap: 128              # チャンク間オーバーラップ（トークン数）
  chunking_strategy: semantic     # チャンキング方式: semantic（推奨）/ fixed
  semantic_min_chunk: 64          # セマンティックチャンクの最小トークン数
  semantic_max_chunk: 512         # セマンティックチャンクの最大トークン数
  top_k: 5                        # 検索結果の上位 K 件
  # LTM / cartridge の取得件数を top_k*N に拡張する (1=拡張なし、上限5)。
  # STM は stm_top_k 固定で拡張対象外。
  # 「広く取って絞る」第1段として候補プールを広げる。LTM は内部で更に *2 する。
  # 目安: LTM 主体なら 2-3 / カートリッジ多装着環境は 1-2。
  fetch_multiplier: 1
  # クロスレイヤ・スコア正規化方式: none / minmax / rank。
  # STM(cosine*0.6+lightmem*0.4) / LTM(raw cosine) / cartridge(cosine*priority、priority 無上限)
  # の異種スケールを層内正規化で揃え、最終順位付けの歪みを抑える。none=従来 (生スコア降順)。
  # 品質判定は常に生スコアで行うため閾値の意味は変わらない。
  score_normalization: none
  # NOTE: hybrid_search / fusion_method / rrf_k / bm25_weight / vector_weight / bm25_* は
  # チャット応答経路 (unified_search の STM/LTM/cartridge) では no-op。これらが効くのは
  # HybridRetriever 経路 (ベンチ評価 / sleep-time の BM25 取り出し) のみ。
  hybrid_search: true             # BM25+Vector ハイブリッド検索（false でベクトルのみ）
  # NOTE: 以下の重み (0.3 / 0.7) は Qwen3-Embedding の vector 品質を前提に
  # 調整した既定値。BGE-M3 / nomic-embed-text 等に切替えた場合は BM25 と
  # vector の相対品質が変化するため、ベンチで再測定して再調整すること。
  bm25_weight: 0.3                # RRF 不使用時の BM25 スコア重み（vector_weight と合計 1.0）
  vector_weight: 0.7              # RRF 不使用時の Vector スコア重み
  fusion_method: rrf              # スコア融合方式: rrf（推奨）/ weighted
  rrf_k: 60                       # RRF 平滑化定数（論文推奨値: 60）
  # --- BM25 チューニング ---
  bm25_k1: 1.5                    # BM25 の TF 飽和度パラメータ（短チャンクなら 1.0〜1.2）
  bm25_b: 0.75                    # BM25 の長さ正規化係数（チャンク長が均一なら 0.5 前後）
  bm25_delta: 1.0                 # BM25Plus の delta 項
  bm25_use_trigrams: false        # true にすると文字 3-gram も併用（index サイズ増）
  bm25_split_ascii: true          # camelCase / snake_case を分割して部分一致向上
  # bm25_stopword_bigrams:
  #   null → 既定ストップワード（日本語助詞中心の bi-gram 集）を使用
  #   []   → ストップワード無効
  #   list → 指定リストで上書き
  bm25_stopword_bigrams: null
  # --- Contextual Retrieval ---
  # チャンク登録時にアシストモデルでドキュメント文脈プレフィックスを生成し、
  # 埋め込み・BM25 の両方で検索精度を向上させる。
  # 参考: https://www.anthropic.com/news/contextual-retrieval
  contextual_prefix:
    enabled: true                # Contextual Retrieval の有効/無効（アシストモデル必須）
    # eager: Sleep-time Step 5.8 で未生成 chunk を一括生成 (従来動作)
    # lazy : retrieval 時に hit した chunk のみ on-demand 生成 (大規模カートリッジ向け)
    mode: eager
    max_tokens: 128              # プレフィックス生成の最大トークン数
    max_doc_chars: 6000          # プレフィックス生成時のドキュメント全文上限文字数（超過時はトランケート）。assist_model.local.context_size を超えないよう注意
    batch_size: 10               # sleep-time で 1 回に処理するチャンク数上限
    # 生成対象の最小チャンクトークン数。短文は prefix の retrieval 寄与が薄いためスキップ
    min_chunk_tokens: 200
    # lazy モード時: retrieval でこの回数以上 hit した chunk のみ prefix を永続化
    lazy_hit_threshold: 2
    # プレフィックス生成プロンプト。プレースホルダ {document} {chunk} 必須。
    # 空 (既定) で日本語テンプレートを使用。英語専用 / 中国語専用アシスト
    # モデルに切替えた場合はここをアシストモデルの学習言語のテンプレートに
    # 差し替えること (品質低下を防ぐため)。
    prompt_template: ""
  # --- ベクトル量子化 ---
  # 注: 現状 VectorStore は常に int8 固定で格納・検索する (quantization は未配線 / no-op)。
  # 検索は「全件 int8 粗検索 → 候補のみ float32 rescore」の 2 段で、none を選んでも float32 化しない。
  quantization: int8             # ベクトル量子化方式（現状 no-op、常時 int8）
  # 注: チャット応答経路 (LTM/cartridge) には未配線。VectorStore.search 内部既定
  # max(50, top_k*3) が常時適用される (本キーの値は届かない)。
  rescore_candidates: 50         # int8 粗検索後の float32 rescore 候補数（現状チャット経路では no-op）
  # --- memmap ---
  memmap_threshold: 10000        # この件数以上で numpy.memmap に切替（OS ページキャッシュに委譲しメモリ削減）
  # --- Cartridge スケーラビリティ運用制限 ---
  max_loaded_cartridges: 20       # 同時 loaded 可能なカートリッジ上限 (0 以下で無制限)。超過時は LRU で最古参を unload
  large_cartridge_warn_chunks: 50000  # load 時にチャンク数がこの閾値以上なら WARNING ログを出す
  cartridge_search_timeout_ms: 3000   # カートリッジ検索全体のタイムアウト (ms)。超過時は空結果を返しチャット応答を止めない (0 で無効)
  # Cartridge Gate: centroid 事前フィルタ。多数カートリッジ装着時に無関係な cart をベクトル検索前にスキップ
  cartridge_gate:
    enabled: true                     # 有効化。centroid 未構築 cart は常に通過するため既存環境でも安全
    # NOTE: threshold=0.3 は Qwen3-Embedding の cosine 分布前提。BGE-M3 等に
    # 切替えた場合は cosine 分布特性が変わるため、ベンチで全 cart skip / 全
    # 通過になっていないか確認して再調整すること。
    threshold: 0.3                    # cosine 類似度閾値。未満の cart はスキップ
    max_cartridges: 10                # gate 通過上限 (0 で無制限)
    # 全カートリッジが threshold 未満の場合の挙動:
    #   false (既定): カートリッジ検索を skip し chunk を返さない。雑談や
    #                ファイル生成依頼などロード中カートリッジと無関係な発話で
    #                RAG chunk が混入するのを防ぐ。STM/LTM 検索は影響なし。
    #   true       : 旧挙動 (全件フォールバック = recall 重視)。
    fallback_when_empty: false
  # Cluster Index: 巨大カートリッジ (> threshold 件) を IVF-KMeans で高速化。numpy のみで実装
  cluster_index:
    enabled: true                     # 有効化。閾値未満の cart はブルートフォースのまま
    threshold: 5000                   # この件数以上の VectorStore で IVF インデックスを構築
    n_probe_ratio: 0.125              # K = max(16, sqrt(N)) のうち n_probe_ratio × K 個のクラスタを探索
  # --- Self-RAG 品質判定閾値 ---
  # NOTE: 以下 3 閾値はチャット応答経路 (unified_search) の Self-RAG 品質判定に適用される。
  # 判定入力は STM(cosine*0.6+lightmem*0.4) / LTM(raw cosine) / cartridge(cosine*priority) を
  # 無正規化マージした merged スコア。embedding family を切替えた場合は
  # cosine 分布が変わるので、全 low / 全 high に倒れないようベンチで分布を観察して再調整すること。
  relevance_threshold: 0.65      # 関連性判定の閾値（0.0〜1.0）
  support_threshold: 0.50        # 根拠支持判定の閾値（0.0〜1.0）
  confidence_threshold: 0.80     # 信頼度判定の閾値（0.0〜1.0）
  hysteresis_band: 0.02          # ヒステリシス幅（閾値近傍の揺れを吸収）
  # --- Self-RAG 補助機能 ---
  self_rag:
    assist_judge:
      enabled: true               # アシストモデルによる品質再判定（marginal 結果の救済）
      max_per_session: 5          # 1 セッション内の発火上限 (0 以下で無制限)
      max_per_query: 1            # 1 クエリ内の発火上限 (0 以下で無制限)
      only_when_quality: ["medium"]  # 発火条件の quality ラベル (high/medium/low から指定)
    assist_necessity:
      # 検索必要性のハイブリッド 3 値判定 (Phase 1 で旧 2 値から拡張)。
      # ルール層 (URL含む / 明示fetch動詞 / TRIVIAL / 長文 question) で
      # `retrieve` / `fetch` / `skip` が確定するケースはアシスト 0 呼び出しで即返す。
      # それ以外の uncertain ケースだけ アシストモデルに 3 値 JSON
      # ({"action": "retrieve" | "fetch" | "skip"}) を問い合わせる。
      # `fetch` は外部 fetch_url ツールに委ねるシグナルで、search_pipeline は
      # `skip` 同等にローカル RAG をスキップする。
      # 失敗 / タイムアウト / 上限到達時は安全側 (`retrieve`) にフォールバック。
      enabled: true               # uncertain 時のアシスト発火 (false で完全ルール運用)
      max_per_session: 10         # 1 セッション内の発火上限 (0 以下で無制限)
      max_per_query: 1            # 1 クエリ内の発火上限 (0 以下で無制限)
      only_when_quality: ["uncertain"]  # tracker キー (互換、変更非推奨)
      timeout_s: 5.0              # アシスト wall-clock 上限 (秒)
      context_turns: 2            # アシストプロンプトに含める直前ターン数 (0 で会話文脈なし)
    content_gate:
      # 取得直後 (Step 4 マージ後) の chunk 内容精査ゲート。低価値 chunk を
      # 事前 pruning し、quality judge / query expansion の候補数を
      # 縮小する。coding mode を主対象 (chat mode は近似重複除去のみ)。判断に
      # 迷う marginal band の prose チャンクだけ assist で 1 回関連性を判定する。
      enabled: true               # coding-mode 事前精査を有効化 (false で無効)
      relevance_floor: 0.45       # cosine スコア下限 (これ未満を pruning)
      marginal_band: 0.10         # [floor, floor+band) を assist 判定対象帯とする
      min_keep: 3                 # 最低保持件数 (生成を枯渇させない)
      dedup_jaccard: 0.85         # token-set Jaccard 近似重複しきい値 (1.0 で無効)
      coding_code_signal: true    # coding mode: marginal 帯のコードシグナル判定
      assist_enabled: true        # marginal band の assist 救済 (false で純ルール)
      max_per_session: 5          # 1 セッション内の assist 発火上限 (0 以下で無制限)
      max_per_query: 1            # 1 クエリ内の assist 発火上限 (0 以下で無制限)
    necessity_recall:
      # embedding 決定論的リコール (ToolCallJudge._try_recall_url と同型)。
      # ルール判定が uncertain になったクエリについて、過去の類似クエリ +
      # assist 自己採点 (sleep-time Step 8.7) から action を直接引き当て、
      # assist 呼出をスキップする。tracker (assist_necessity の発火上限) を
      # 消費せず、assist_client=None (degraded) でも動作する。
      enabled: true
      topk: 5
      min_score: 0.75             # 質問 embedding 類似度閾値 (url/command recall の 0.7 よりやや高め)
      min_record_score: 0.65      # 過去自己採点平均の閾値
      record_history_size: 10
      ttl_days: 14                 # KB変化の影響を受けやすいため url recall (30日) より短め
    quality_recall:
      # necessity_recall と同型。ルールベース品質判定が marginal
      # (既定 "medium") のクエリについて assist_judge の呼出をスキップする。
      enabled: true
      topk: 5
      min_score: 0.75
      min_record_score: 0.65
      record_history_size: 10
      ttl_days: 14

# ===== 埋め込みモデル設定 =====
embedding:
  backend: llama-cpp              # 埋め込みバックエンド: llama-cpp
  llama_host: localhost            # llama-server ホスト（backend: llama-cpp 時）
  llama_port: 8082                 # llama-server ポート（backend: llama-cpp 時）
  dim: 1024                        # 埋め込みベクトルの次元数（Qwen3-Embedding-0.6B: 1024）
  timeout: 30.0                    # 埋め込みリクエストのタイムアウト（秒）
  model_name: Qwen/Qwen3-Embedding-0.6B       # HuggingFace モデル名
  max_length: 8192                # 入力最大トークン長
  # 文脈長 (-c)。必ず max_length 以上にすること (下回ると長入力で 500)。
  # モデル既定 n_ctx=32768 は過剰なので max_length に合わせて縮小し KV を節約する
  # (実測 0.6B で active WorkingSet 7.5GB→4.2GB、速度・次元は同等)。
  context_size: 8192
  # 埋め込みモデルの GPU オフロード層数
  # null は CPU フォールバック (-ngl 0) が既定。GPU に載せたい場合は
  # 明示的に 999 等を指定する。ベースモデルの llama.gpu_layers には追従しない。
  # 補足: 埋め込みの GPU オフロードはクエリ時最大の速度ノブ。base/assist との
  # VRAM 競合に注意し、設定変更時は起動時サマリで VRAM 予算を確認すること。
  gpu_layers: null                # 既定: CPU 配置 (弱い GPU 環境での OOM 回避)
  # 物理バッチサイズ。llama-server デフォルト 512 のままだと長文ノート (>512 tok)
  # の単一埋め込みリクエストで 500 エラーになり、EvorefMem sleep-time update が連鎖失敗する。
  # 4096 は rag.chunk_size (既定 512) + STM ノート (通常 <2048 tok) を十分カバーし、
  # メモリも 8192 と比べて省ける妥当値。長文ファイル (>4096 tok の単一リクエスト) を
  # 扱う場合のみ 8192 に上げる選択肢が残る。
  # 注意: ggml-vulkan の pinned memory warning は batch_size とは独立に出る
  # (model loading 時の host buffer 確保で発生、ggml-vulkan.cpp:14079)。batch_size
  # を下げても警告は消えない。CPU buffer フォールバックで動作上は問題なし。
  batch_size: 4096                # -b: 論理バッチサイズ
  ubatch_size: 4096               # -ub: 物理バッチサイズ
  # 並列スロット数 (-np)。未指定だと llama.cpp が n_parallel=auto(=4) を選び
  # slots × context_size 分の KV を無駄に確保する。埋め込みは概ね逐次アクセスの
  # ため 2 (前景クエリ + 背景ノート埋め込みの最小並列) で十分。
  slots: 2
  # スレッド数 (-t)。0=自動検出 (全物理コア)。CPU 埋め込み (gpu_layers: null/0) 時は
  # base/assist と CPU を分け合うため、物理コア数より小さい値を指定して
  # ヘッドルームを残すとチャット応答との競合を抑えられる。
  threads: 0
  # --- 永続埋め込みキャッシュ ---
  # チャンクテキストのハッシュをキーに埋め込みベクトルをディスクにキャッシュ。
  # 再登録・rebuild 時に同一チャンクの埋め込み計算をスキップする。
  cache_enabled: true             # 永続埋め込みキャッシュの有効/無効
  cache_max_mb: 100               # キャッシュ上限サイズ（MB、超過時は LRU eviction）
  cache_dir: local/cache/embeddings/  # キャッシュ保存先ディレクトリ
  # 起動時に embedder dim と既存ベクトルの不整合を検出した際の自動再構築。
  # false (既定): WARNING ログのみ出して embedding_dim_mismatch フラグを立て、
  #              運用者の `evoref reindex` 手動実行を待つ。
  # true       : run_reindex を自動実行 (モデル切替直後の RAG ダウンタイムを縮める)。
  auto_reindex_on_mismatch: false
  # idle slot offload。埋め込みは chat slots を使わないため
  # 上流既定 8192 MiB の RAM 予約は無意味。0 で明示 disable する。
  cache_ram_mib: 0
  # instruction-aware モデル (Qwen3 等) 用の mode 別 task description。
  # mode は chat / coding のいずれか。
  instructions:
    chat: "Given a user question, retrieve relevant passages that answer the query"
    coding: "Given a code search query, retrieve relevant code snippets"
  # クエリ整形テンプレート。{task} (= instructions[mode]) と {query} を埋め込む。
  # 既定は Qwen3-Embedding 公式仕様。BGE-M3 等の非 instruction-aware モデルに
  # 切り替える場合は "" (空文字列) を指定し prefix を一切付与しない。
  query_template: "Instruct: {task}\nQuery: {query}"
  # ドキュメント整形テンプレート。Qwen3 仕様では空 (prefix なし)。
  # 対称型埋め込み (例: e5) で文書側にも prefix が要る場合のみ設定。
  doc_template: ""
  # Pooling 方式 (llama-server --pooling: none/mean/cls/last/rank)。既定 null は
  # フラグを付与せず llama-server のモデル既定 pooling に委ねる (Qwen3-Embedding
  # 等の既存挙動を変えない)。BGE-M3 (arch "bert") 等 CLS pooling が正しいモデルへ
  # 切替える場合、embed 切替時に models/profiles/bert.yaml から "cls" が自動
  # 転写されるため通常は手動設定不要。
  pooling: null

# ===== メモリシステム設定 =====
memory:
  schema_version: 1               # EvorefMem スキーマバージョン
  # --- Subject 正規化辞書 ---
  subject_dictionary:
    enabled: true                                              # 正規化を有効化
    file: local/memory/semantic/subject_dictionary.json        # 辞書ファイルのパス
    auto_expand: false                                         # 自動拡張は仕様で禁止
  # --- ファクト抽出 ---
  facts:
    extraction_skip_subject_canonicalize_regex: '^harness\.'   # ハーネス系 subject は辞書スキップ
    enable_extraction: true                                    # Step 8 Extractor 全体オンオフ
    trigger: idle_full_only                                    # 抽出トリガ (Trigger B = run_full のみ)
    extract_from_mdp_trace: true                               # agent_trace.jsonl から MDP 抽出
    ingest_mdp_trace_to_ltm: true                              # agent_trace.jsonl を episodic LTM に投入
    extraction_max_pinned_per_session: -1                      # pinned 由来の上限 (-1=無制限)
    extraction_max_per_session:                                # セッションあたりの抽出上限
      chat: 10
      coding: 5
  # --- Pin 機能 ---
  # トリガ辞書 (pin_triggers.yaml / fact_triggers.yaml / classify_triggers.yaml) は
  # 同梱 default を backend/free/memory/_defaults/triggers/ に配置し、user override
  # は local/triggers/<name>.yaml に置く 2 段階解決 (override 優先)。config では指定しない。
  pin:
    auto_detect: true                                          # 自動 Pin 検出 (覚えて/重要/忘れないで等)
    auto_detect_confirm: false                                 # 検出時に確認を要求するか
    unlimited: true                                            # pin 数上限なし
  # --- プライベートセッション ---
  # private: true のターンは memory_only で動作し、LTM/SemMem への昇格と
  # 会話履歴のディスク永続化をスキップする。セッション終了時に揮発する。
  private:
    default: false                                             # セッション開始時のデフォルト private モード
    history_storage: memory_only                               # memory_only | skip — WM/STM のみ保持し永続化スキップ
  # --- SemMem コンフリクト解消 ---
  conflict:
    default_mode: auto                                         # auto: 例外を除き自動マージ / manual: 全件 pending
    confirm_window_hours: 1.0                                  # 同 source / N 時間以内は微妙ケースとして pending
    project_tag_always_manual: true                            # project / policy タグは基本ユーザー確認必須
    auto_for_evolved_policies: true                            # 例外: auto_evolved=True の policy のみ自動マージ
    # pending 競合の TTL 自動解消: グループ内最新ファクトの created_at から
    # N 日経過した pending を sleep-time Step 6B が keep_new で自動解消する。
    # pinned / project / policy を含むグループは対象外 (チャット回答でのみ解決)。
    # default_mode: manual でも有効。0 で無効。
    pending_auto_resolve_days: 3.0
    # pending 競合のチャット確認フロー。チャット注入で AI がユーザーに確認し、
    # 回答を assist (conflict_chat_judge) で判定して即時解決する。
    chat_review:
      enabled: true                                            # false で注入・判定とも停止
      max_groups: 0                                            # 注入グループ上限 (0=無制限、超過分は件数のみ要約)
      # conflict_chat_judge (assist) のセッション内発火上限。上限到達後は同一
      # セッションでの判定と pending 注入を停止する (滞留 pending が毎ターン
      # realtime スロットを専有するのを防ぐ)。0 = 無制限。
      max_judge_per_session: 3
  # --- MemoryInjector ---
  # NOTE: policy ファクトの active 閾値は learning.policy.activation_min_confidence
  # に集約されている
  # MemoryInjector / PolicyInterpreter / LoopFactView 等すべて同一閾値で動作する。
  injection:
    chat_budget_tokens: 800                                    # チャットモードの注入予算 (tokens)
    coding_budget_tokens: 2000                                 # コーディングモードの注入予算 (tokens)
    tier_ratios:
      chat: [0.40, 0.35, 0.15, 0.10]                           # Tier 1〜4 比率 (合計 1.0)
      coding: [0.40, 0.35, 0.15, 0.10]                         # Tier 1〜4 比率 (合計 1.0)
  working_max_turns: 10           # ワーキングメモリの最大ターン数
  working_max_tokens: 2048        # ワーキングメモリの最大トークン数
  # 推奨: 512〜(context_size * 0.6) の範囲で設定
  # | context_size | 上限目安 | 推奨値 |
  # |       4,096  |    2,457 |  2,048 |
  # |       8,192  |    4,915 |  4,096 |
  # |      16,384  |    9,830 |  8,192 |
  # |      32,768  |   19,660 | 16,384 |
  # 下限 512: これ以下だと毎ターン圧縮が発動し会話が成立しない
  history_min_tokens: 1024        # 過去履歴の最低確保トークン数 (床)。RAG 等の動的ブロックより優先して確保。0 で無効
  short_term_max_notes: 100       # 短期メモリの最大ノート数
  lightmem_decay_days: 7          # LightMem スコアの減衰日数 (デフォルト半減期)
  # --- タグ別半減期 (日)。未指定タグは lightmem_decay_days を使用 ---
  # `policy` / `progress_marker` / `project` は実質無限 (9999)、
  # `failure_pattern` は中期 (60)、`belief` は長期 (180)。
  half_life_days_by_tag:
    personal_fact: 90
    world_fact: 14
    preference: 60
    emotion: 30
    opinion: 21
    belief: 180
    decision: 60
    commitment: 30
    project: 9999
    coding: 60
    task: 14
    coding_task: 14
    policy: 9999
    fewshot: 9999        # policy subtype から独立
    failure_pattern: 60
    progress_marker: 9999
  # --- SemMem 容量上限 + GC ---
  # sleep-time Step 9 内で type 別に上限超過分を gc_strategy に従って削除する。
  # pinned ファクトと supersede 済ファクトは対象外。スコアは
  # eval_metric.fitness > confidence の順で評価し、低いものから削除する。
  semmem_limits:
    personal_fact: 10000
    world_fact: 5000
    preference: 5000
    emotion: 3000
    opinion: 3000
    belief: 1000
    decision: 5000
    commitment: 2000
    project: 10000
    coding: 10000
    task: 5000
    coding_task: 5000
    policy: 5000
    fewshot: 2000                 # policy subtype から独立
    failure_pattern: 2000
    progress_marker: 5000
    enforcement: hard             # hard | soft (soft は削除しない計測専用)
    gc_strategy: lowest_score     # 削除戦略 (現在は lowest_score のみ)
  # --- プロジェクトアーカイブ ---
  # 指定日数アクセスのないプロジェクトを semantic/archive/ に物理移動する
  # (自動削除はしない)。0 で無効化。
  project:
    auto_archive_inactive_days: 180
    archive_dir: local/memory/semantic/archive
  # --- FadeMem 適応的忘却 (arXiv:2601.18642) ---
  fade_alpha: 0.4                 # 関連性の重み（コーディング用途は 0.5 推奨）
  fade_beta: 0.3                  # アクセス頻度の重み（alpha + beta + gamma = 1.0）
  fade_gamma: 0.3                 # 時間減衰の重み
  fade_threshold: 0.15            # これ以下のスコアを削除候補に
  conflict_similarity_threshold: 0.85  # これ以上の類似ノートをコンフリクト候補に
  conflict_batch_size: 5          # コンフリクト解決のバッチサイズ
  # --- A-MEM ノート進化 (arXiv:2502.12110) ---
  note_evolution_enabled: true    # sleep-time でノート文脈説明を LLM が生成
  note_evolution_batch: 10        # 1 回の sleep-time で処理するノート上限
  note_evolution_context_k: 3     # 進化時に参照する関連ノート数
  llm_call_base_interval: 1.0    # LLM 呼び出し間の基本待機秒数（7B モデル基準、モデルサイズで自動調整）
  # --- A-MEM リンク張り直し + クラスタリング (LLM 不要) ---
  note_link_rebuild_enabled: true # sleep-time Step 7 で STM ノート間リンクを再構築
  note_link_top_k: 5              # 各ノートに張るリンクの上限
  note_link_threshold: 0.5        # コサイン類似度しきい値 (これ未満は張らない)
  note_clustering_enabled: true   # union-find で連結成分から cluster_id を割り当てる
  # --- NoteEvolver / ConflictResolver の LLM スキップ閾値 ---
  note_evolver:
    # confidence がこの値以上のノートは LLM 進化をスキップ (ルールベースのみ)
    # 0.0 で全ノート LLM 進化 (現行挙動と同等)、1.0 で LLM 進化を完全停止
    confidence_threshold: 0.7
    # 1 サイクルあたり LLM 進化呼び出しの上限 (note_evolution_batch と小さい方を採用)
    max_per_cycle: 10
  conflict_resolver:
    # LLM 統合を実行する最小類似度。detect 閾値 (conflict_similarity_threshold)
    # 以上 / この値未満の中間帯は LLM 呼び出しをスキップし低優先度扱いにする
    min_merge_similarity: 0.85
    # 1 サイクルあたり LLM 統合呼び出しの上限 (conflict_batch_size と小さい方を採用)
    max_per_cycle: 5

# ===== スケジューラ tz 設定 =====
# 内部時刻は全て UTC で扱うが、「夜間 N 時に学習を実行」のような
# ユーザ体感のローカル時刻で判定したい処理はこの tz で UTC→ローカル変換する。
# サーバの OS tz には依存しない。ZoneInfo (IANA) 形式で指定する。
schedule:
  local_tz: Asia/Tokyo            # 例: Asia/Tokyo / UTC / America/Los_Angeles

# ===== 学習サイクル設定 =====
learning:
  # base モデルの自己学習データを (base モデル識別子 × モード) で分離する。
  partition_by_base_model: true   # true: local/learning/<base_model_stem>/ 配下へ分離しモデル切替で差し替え（未知モデルはゼロから学習）。false: レガシー flat（即ロールバック用）
  level2_adapter_partition: model # LoRA限定(cvectorは常にモデル単位・対象外)。model（既定=base/assistともモデル単位・mode切替で再起動なし）/ model_mode（base/assistともmode単位・切替時にLoRAパスが変わればサーバ再起動、partition_by_base_model=true必須）
  level1_min_experiences: 20      # Level 1 トリガーに必要な最小経験数
  level1_generations: 10          # Level 1 の世代数
  level1_population_size: 5       # Level 1 の集団サイズ
  level2_min_failures: 50         # Level 2 トリガーに必要な最小失敗数
  # アイドル判定タイマー
  full_idle_minutes: 10           # Trigger B: sleep-time Full の起動アイドル時間（分）
  level1_idle_minutes: 30         # Trigger C: Level 1 の起動アイドル時間（分）
  level1_recheck_interval_sec: 60 # Level 1 ループ再評価間隔（秒）
  priority_threshold_ratio: 0.5   # 優先 Level 1 の経験数閾値緩和率
  active_minutes: 5               # user_active 判定閾値（分）— Level 2 中断判定
  level2_spsa_iterations: 500     # Level 2 SPSA の反復回数
  level2_sparse_params: 200       # Level 2 のスパースパラメータ数
  level2_schedule_hour: 3         # Level 2 の優先窓ヒント時刻（強制ではない）
  level2_recheck_interval_sec: 300  # Level 2 常駐ループの再評価間隔（秒、再起動耐性）
  level2_overdue_hours: 24.0      # 前回実行からこの時間超で overdue 発火
  level2_bootstrap_enabled: false # 初回 full-train（初期 LoRA 生成）。実 llama-server ロード検証後に true 推奨
  level2_bootstrap_rank: 8        # bootstrap LoRA の rank
  level2_bootstrap_init_sigma: 0.0001  # lora_a 初期ガウス標準偏差（lora_b=0）
  level2_bootstrap_min_failures: 20    # 初回 bootstrap の最小失敗数（本学習 50 より低め）
  # Level 2 base=C: ベースモデルを control vector で操舵 (Pro 限定)。実 --control-vector ロード検証後に cvector へ
  level2_base_method: lora             # lora（既定=base は #3a で trigger-skip、何も起動しない）/ cvector（base 実学習）
  cvector_method: pca                  # pca / mean (llama-cvector-generator --method)
  cvector_pca_batch: 100               # --pca-batch
  cvector_pca_iter: 1000               # --pca-iter
  cvector_layer_range: ""              # 空=block_count から全層自動 / "START END" 指定可
  cvector_scale: 1.0                   # --control-vector-scaled FNAME:SCALE
  cvector_seed_pairs_file: ""          # キュレーション種ペア JSON（空=組込デフォルト軸）
  cvector_min_experiences: 40          # HYBRID 対照例（種＋経験）の最小数
  # パターン検出キーワード学習
  pattern_max_patterns: 200       # 学習済みパターンの最大数
  pattern_initial_weight: 0.5     # 新規パターンの初期重み
  pattern_decay_rate: 0.05        # sleep-time ごとの重み減衰量
  pattern_boost_amount: 0.15      # 訂正検出時のブースト量
  pattern_min_weight: 0.1         # この重み未満のパターンは削除
  pattern_match_threshold: 0.3    # マッチング時の最小重み閾値
  # ツールパターン学習
  tool_pattern_boost_success: 0.03    # 成功時のブースト量
  tool_pattern_decay_false_pos: 0.1   # 誤検出時の減衰量
  tool_pattern_match_threshold: 0.4   # マッチ閾値（通常パターンより高め）
  # Few-shot プール
  fewshot_pool_size: 50               # モード別最大プールサイズ
  fewshot_min_fitness: 0.7            # プール追加の最低 fitness
  fewshot_max_examples: 3             # プロンプトに埋め込む最大 Few-shot 数
  fewshot_diversity_threshold: 0.8    # 重複判定のコサイン類似度上限
  # Level 2 アシストモデル
  assist_level2_min_experiences: 30   # アシストモデル Level 2 の最小経験数
  assist_spsa_iterations: 300         # アシストモデル SPSA 反復回数（assist=B 使用時は ~30 推奨: 1 iter=候補サーバ2回起動）
  assist_sparse_params: 100           # アシストモデルのスパースパラメータ数
  # Level 2 assist=B: assist LoRA 候補を ephemeral サーバに実ロードして実推論評価 (Pro 限定)。実 --lora ロード検証後に spsa-real-eval へ
  level2_assist_method: none          # none（既定=assist は #3a で trigger-skip、何も起動しない）/ spsa-real-eval（assist 実学習）
  assist_eval_scratch_port: 8090      # 候補評価サーバのスクラッチポート
  assist_eval_loss_w1: 0.7            # keyword/pattern 一致項の重み
  assist_eval_loss_w2: 0.3            # mean neg-logprob 項の重み
  assist_eval_max_tokens: 64          # 候補評価生成のトークン上限
  assist_eval_max_cases: 20           # 候補評価に使う held-out ケース上限
  assist_eval_health_timeout: 120     # 候補サーバ起動の health 待ち秒数
  level2_assist_bootstrap_enabled: false  # assist B=0 種生成。実 --lora ロード検証後に true
  level2_assist_bootstrap_rank: 8     # assist bootstrap LoRA の rank
  level2_assist_bootstrap_init_sigma: 0.0001  # lora_a 初期ガウス標準偏差（lora_b=0）
  # トークン予算進化
  budget_generations: 5               # トークン予算進化の世代数
  budget_sigma: 0.05                  # トークン予算進化の摂動スケール
  budget_max_total_ratio: 0.7         # 各戦略の比率合計の上限
  # 変異生成 LLM 設定
  prompt_mutator_base: assist         # ベースモデル変異生成の LLM（main / assist）。低速 base のタイムアウト回避のため既定 assist
  prompt_mutator_assist: main         # アシストモデル変異生成の LLM（main / assist）
  # ポリシー / 進化結果書き戻し設定
  # PolicyInterpreter / PolicyParamEvolver / FewShotPool の永続化先と進化挙動。
  #
  # - source:
  #     yaml   : 従来通り local/policies/*.json のみを参照 (既定)
  #     hybrid : YAML を seed としてロード後、SemMem の active な policy ファクト
  #              (subject 先頭が `learn.policy.`) で上書き
  #     semmem : 導入予定 (現状は hybrid と同等)
  # - activation_min_confidence: SemMem 上の policy ファクトを active と
  #   見なす最小 confidence。これ未満は YAML 値が温存される。
  #   PolicyInterpreter / LoopFactView / MetaCognitiveAgent / SelfCartridge /
  #   bootstrap_loop_context_at_startup が共通参照する。
  # - evolve_writeback: 進化結果の書き戻し先
  #     yaml   : local/prompts/policy_evolver_state.json / fewshot_pool.json (既定)
  #     semmem : SemMem の policy / fewshot ファクトに書き戻し
  policy:
    source: yaml                      # yaml | hybrid | semmem
    activation_min_confidence: 0.7
    evolve_writeback: yaml            # yaml | semmem (D-2 で semmem 化予定)

# ===== ストリーミング設定 =====
streaming:
  keepalive_interval_sec: 15.0    # Meta-Cognitive 層のキープアライブ送信間隔（秒）

# ===== エージェント設定 =====
agent:
  step_compaction_enabled: true          # ステップ結果圧縮の有効/無効
  step_compaction_rag_lines: 2           # RAG 圧縮時に各チャンクから残す行数
  step_compaction_command_head_tail: 5   # コマンド出力の先頭/末尾行数
  reminders_enabled: true                # イベント駆動リマインダーの有効/無効
  max_reminders_per_turn: 2              # 1 回の LLM 呼び出しに注入する最大リマインダー数
  dangerous_command_block: true          # 危険コマンドをブロック（false=警告のみ）
  tool_judge_enabled: true               # ツール判定。アシスト接続時はモード非依存で常時有効。false で明示オプトアウト（アシスト未接続時は本値に関わらず無効）
  meta_cognitive_enabled: true           # Meta-Cognitive 層（計画+多段推論+ツールループ）の有効/無効
  meta_cognitive_min_budget: 512         # Meta-Cognitive 発動に必要な最小ループ予算（トークン数）
  reactive_light_enabled: true           # reactive 分類かつルール即応に該当しないクエリを、tool 判定で tool 不要なら base 1 ターンの軽量パスで応答（false で常に deliberative）
  executable_command_fallback_enabled: true   # 4 層判定が全て no-tool の時、assist で環境依存事実クエリを run_command に橋渡しする 5 層目（false で無効化）
  executable_command_fallback_min_chars: 5    # 5 層目 assist 呼出をスキップするクエリ長閾値（これ未満は呼ばない）
  # ── コンテンツ生成タイムアウト (Meta-Cognitive 層) ──
  content_gen_first_token_timeout: 120   # 最初のトークン到達までの許容秒数（サーバ混雑時の待機。idle と分離）
  content_gen_idle_timeout: 30           # トークン間の無出力許容秒数（2トークン目以降、超過で「停止」とみなし中断）
  content_gen_timeout: 600               # ファイル内容生成の総上限秒数（低速 GPU でも完走できるよう緩和）
  llm_call_timeout: 90                   # 計画生成など単発 LLM 呼出のタイムアウト（秒）
  total_timeout: 1800                    # Meta-Cognitive 全体のタイムアウト（秒、content_gen_timeout / 長文 codegen を内包）。低速 GPU の長文生成を完走させるため余裕を持たせる
  delegate_codegen_to_longform: true     # coding: editor/chat のコード生成を LongForm 細粒度生成へ委譲(複数ファイル可)。false で単一ショット生成

# ===== ツール設定 =====
tools:
  fetch_url_enabled: true         # fetch_url ツールの有効化（true で URL フェッチを許可）
  fetch_url_timeout: 10           # fetch_url のタイムアウト（秒）
  fetch_url_allow_private_ip: false  # true で localhost / private IP / link-local への接続を許可（既定 false で SSRF 対策）
  # ── URL リコール (Phase 1) ──
  # 過去質問で正しく fetch_url できた URL を新規の類似質問で再利用する。
  # 書込は sleep-time の url_curator が担当（アシスト自己採点）、引き当ては
  # ToolCallJudge が embedding 類似度 + 過去採点平均で決定論的に行う。
  url_recall_enabled: true            # URL リコール機能の有効/無効
  url_recall_topk: 5                  # 引き当て時に走査する近傍ファクト数
  url_recall_min_score: 0.7           # 引き当てに必要な質問 embedding 類似度閾値
  url_recall_min_record_score: 0.6    # 引き当てに必要な過去採点平均の閾値
  url_recall_record_history_size: 10  # 1 URL fact あたり保持する採点履歴件数
  url_recall_ttl_days: 30             # 最終 fetch から N 日経過で score を半減 (0=TTL 無効)
  # ── executable command リコール ──
  # 過去成功した run_command を新規の類似クエリで再利用する。
  # 書込は sleep-time の executable_command_curator (tool_command_success を記録)、
  # 引き当ては ToolCallJudge が embedding 類似度 + 過去成功率で決定論的に行う。
  executable_command_recall_enabled: true            # executable command リコールの有効/無効
  executable_command_recall_topk: 5                  # 引き当て時に走査する近傍ファクト数
  executable_command_recall_min_score: 0.7           # 引き当てに必要なクエリ embedding 類似度閾値
  executable_command_recall_min_record_score: 0.6    # 引き当てに必要な過去成功率の閾値
  executable_command_recall_record_history_size: 10  # 1 command fact あたり保持する成否履歴件数
  executable_command_recall_ttl_days: 30             # 最終実行から N 日経過で score を半減 (0=TTL 無効)

# ===== ウィジェットプロキシ設定 =====
# テーマのスロットコンポーネントから外部 API と連携する際のプロキシ設定。
widget_proxy:
  enabled: false                  # true でウィジェットプロキシを有効化
  global_rate_limit: 60/min       # 全 API 合算のレート制限
  request_timeout_sec: 10         # プロキシリクエストのタイムアウト（秒）
  max_response_size_kb: 512       # レスポンスサイズ上限（KB）
  cache_ttl_sec: 60               # レスポンスキャッシュの TTL（秒、0=無効）
  apis: []                        # 許可する外部 API 定義（テーマインストール時に追加）
  # 例:
  # apis:
  #   - name: weather
  #     base_url: https://api.openweathermap.org
  #     api_key_env: OPENWEATHER_API_KEY
  #     rate_limit: 10/min
  #     allowed_paths:
  #       - /data/2.5/weather
  #       - /data/2.5/forecast

# ===== i18n 設定 =====
i18n:
  locale: ja                      # 表示言語: ja / en
  fallback: ja                    # フォールバック言語
  prompt_locale: ja               # プロンプト言語: ja / en（切替時にデフォルトに戻り再学習）

# ===== デバッグ設定 =====
# 旧 `debug:` セクションは削除されました。develop モードのログ制御は
# CLI フラグ `--develop=<level>` (debug | investigate | evolve) の SSOT に
# 集約されています。`config.yaml` に `debug:` セクションを書くと起動時
# (Pydantic バリデーション) で ValidationError になります。
#
# レベル別仕様:
#   - debug       : Free / Pro 共通。requests.jsonl のみ。即時 BUG 解析向け。
#   - investigate : Pro 限定。requests/rag/memory/long_form。挙動把握向け。
#   - evolve      : Pro 限定。既存 6 系統 + decision/outcome (PR-C で追加)。
#                   loop 自己学習向け。
#
# 通常起動 (--develop 未指定) では backend.log が INFO+ で固定されます。

# ===== アシストモデル設定 =====
# メモリ・RAG 処理用の補助 llama-server インスタンス。
# 全エディションで必須。ベースモデルとは別インスタンスで起動する。
assist_model:
  enabled: true                    # false でアシストモデル無効化。health_check を経由せず None を注入し、
                                   # ツール判定・メモリ進化・長文プラン・検索品質判定は
                                   # フォールバックモードで動作する
  local:
    host: 127.0.0.1               # アシストモデル llama-server のホスト
    port: 8081                     # アシストモデル llama-server のポート
    context_size: 8192             # アシストモデルのコンテキストサイズ（デフォルト: 8192）
                                   # Contextual Retrieval のプレフィックス生成や note_evolve の入力を
                                   # 収容するため、2048 ではオーバーフローで空応答となるので避ける
                                   # ベースモデルの context_size とは独立して設定可能
                                   # null にすると assist モデルの arch プロファイル
                                   # (models/profiles/<arch>.yaml の context_size) を使用
                                   # (解決順: ここの明示値 > profile > 8192)
    # reasoning OS-fence。per-request の chat_template_kwargs.enable_thinking=false
    # (assist_client.py) だけに頼らない二重防御として、サーバ起動時点で thinking を
    # 抑止する。mode:none (qwen2/lfm2 等、非thinking) では no-op、mode:always
    # (lfm2moe 等、強制thinking) ではサーバ側制御が効かないケースもあるが、その場合も
    # クライアント側 `_ReasoningFilter` の strip が最終防御として機能するため無害。
    reasoning: "off"
    reasoning_budget_default: 0    # --reasoning-budget 0 (即終了)。reasoning: off とセットの二重防御
    # KV キャッシュ量子化 (VRAM 半減、短文の構造化判定用途では品質劣化ほぼゼロ)。
    cache_type_k: q8_0
    cache_type_v: q8_0
    # 共通 prefix (system prompt 等) の自動再利用。同一 purpose の繰り返し呼出で
    # prefill コストを削減する保険 (SWA 構成モデルでは llama.cpp 側が自動無効化し
    # no-op になりうる)。
    cache_reuse: 256
    # slots: 既定 1 (本セクションに slots キー無し = -np 1)。チャット応答パスの
    # assist 判定を並列化する場合は slots: 2 を追加し、``concurrency.realtime: 2``
    # とセットで設定する。slots>1 では ``--kv-unified`` が自動付与され (下記
    # kv_unified)、per-seq context は full context_size を維持する (分割されない)。
    # idle slot offload。cache_ram_mib は host RAM 退避量で kv-unified とは独立。
    # 既定 slots=1 では退避対象の idle slot が無いため 0。slots>1 で idle slot の
    # RAM 退避も欲しい場合のみ 2048 等にする (per-seq context には影響しない)。
    cache_ram_mib: 0
    cache_idle_slots: true
    # null=auto (slots>1 で ``--kv-unified`` 自動付与) / true|false で明示上書き。
    kv_unified: null
    # アシストモデルのパラメータ数 (B 単位) を明示指定する。
    # null (既定) で model 名の正規表現 (\d+B) → /props の順に推定する。
    # モデル名に B 表記がない GGUF (例: custom-1.7b-q4.gguf の小文字 b) や、
    # 量子化版で実効性能が異なる場合に明示指定する。note_evolver /
    # conflict_resolver の sleep-time インターバル計算で 7B 基準のスケーリ
    # ングに使われる。
    params_b: null
    # MTP (Multi-Token Prediction) self-speculative。Free/Pro 共通。アシストモデル
    # 内蔵の MTP ヘッド (NextN 層) を draft に使う自己投機 (外部 draft モデル不要)。
    # MTP ヘッド内蔵モデルでのみ有効、非対応モデルでは warning + 素通り。
    # 既定 null (フラグ未付与)。有効化する場合のみ下記ブロックを設定する。
    # mtp:
    #   enabled: false               # 対応モデルで true にすると MTP を有効化
    #   draft_n_max: 3               # ``--spec-draft-n-max`` (上流既定 3)
  model_path: ""                   # アシストモデルパス（通常は model_paths.assist_model を参照）
  timeout: 30.0                    # タイムアウト（秒）. CogWriter Plan 生成 (max_tokens=1024) 等の長め応答を許容するため 30 秒を推奨
  # 用途別セマフォ。realtime / background / learning を独立
  # スロット化し、Sleep-time (Step 5.8 contextual_prefix 等) / Level 2
  # (critique_synthesis) が並行稼働してもチャット応答パスの realtime
  # リクエストがキュー待ちしないようにする。purpose → priority の対応は
  # AssistModelClient._PURPOSE_PRIORITY_MAP を参照。
  #
  # realtime を 2 にすると、チャット 1 ターン内の assist 判定 (conflict 判定 /
  # 検索必要性判定 / tool 判定 + 層5 投機 synth) が並列化され、短い応答の直列
  # 待ちが縮む。効果を得るには assist llama-server 側の ``local.slots`` も 2 に
  # 揃える (片方だけだとクライアントかサーバのどちらかでキュー待ちになり効果
  # ゼロ)。並列時は assist 同士の GPU バッチ競合で個々の判定が 1.3-1.6 倍に
  # 延びるが、壁時計時間では短縮する (タイムアウト既定は 15s に調整済み)。
  concurrency:
    realtime: 1                    # self_rag_judge / tool_judgment / meta_cognitive_plan (2 で並列化、local.slots:2 とセット)
    background: 1                  # contextual_prefix / long_form / ralph_loop / note_evolution / conflict_resolution
    learning: 1                    # critique_synthesis / policy_evolution / spsa
  # JSON 応答 purpose に GBNF/json_schema 制約サンプリングを適用するか
  # true: OAI 互換 ``response_format: {"type": "json_schema", ...}`` を /v1/chat/completions
  #   に送信し、Pydantic schema (backend/free/llm/json_schemas.py) で文法外トークンを抑制。
  #   小規模 LLM の JSON 応答エラー率を構文レベルで 0 化できる。
  # false: 旧来の json_extract.py フォールバック (コードフェンス除去 / balanced 抽出) のみ。
  #   古い llama-server build (response_format: json_schema 未対応) や、パースエラー切り
  #   分け用に使用する。
  response_format_enabled: true
  # 用途別タイムアウト (秒)
  # 解決優先順:
  #   1. 明示指定 (`timeout` 引数)
  #   2. `assist_model.timeouts[purpose]` (このセクション)
  #   3. `PURPOSE_TIMEOUT_DEFAULTS[purpose]` (コード既定 / `backend/free/llm/assist_client.py`)
  #   4. `assist_model.timeout` (グローバル既定)
  # 本セクションを省略しても、DEFAULTS により以下と同等値が自動適用される。
  # 明示する場合はサイト固有チューニング、または DEFAULTS にない purpose の追加で使う。
  timeouts:
    contextual_prefix: 60.0           # Sleep-time Step 5.8 の長文 document prefix 生成
    long_form_planning: 90.0          # CogWriter Plan 生成 (4-8k tok 入力)
    long_form_code_review: 90.0       # CogWriter コードレビュー
    long_form_text_review: 90.0       # CogWriter テキストレビュー
    # conflict_resolution: 明示しない (DEFAULTS 15s + 反応的自己較正に委譲)。明示すると
    #   較正が無効化され低速 assist で 15s 固定の ReadTimeout を連発し SemMem auto-merge
    #   が停滞するため、ここでは敢えて省略する。
    critique_synthesis: 45.0          # 失敗クラスタ解析
    policy_evolution: 45.0            # PolicyParamEvolver 候補 JSON 生成
    note_evolution: 20.0              # A-MEM note 進化の軽量要約
    meta_cognitive_plan: 30.0         # coding mode タスク分解
    summarize: 30.0                   # Recurrent 戦略の summary 再帰更新
  # 用途別 reasoning_budget (thinking token 上限)
  # ``chat_template_kwargs.reasoning_budget`` として送信される。
  # -1 = 無制限 / 0 = 即終了 / N>0 = N トークン上限。
  # サーバ側 ``-rea off`` (= `local.reasoning: off`) で起動している場合 (推奨) は
  # そもそも thinking が disable されるため本値は no-op だが、``-rea auto`` / ``on``
  # 運用時に purpose 単位で budget を絞る安全側デフォルトとして機能する。
  # 本セクションを省略しても、PURPOSE_REASONING_BUDGET_DEFAULTS により以下と同等値が
  # 自動適用される。
  reasoning_budgets:
    long_form_planning: 2048
    long_form_code_review: 2048
    long_form_text_review: 2048
    contextual_prefix: 256
    critique_synthesis: 512
    conflict_resolution: 0            # マージ判定は thinking 不要
    policy_evolution: 1024
    meta_cognitive_plan: 0            # 機械的なタスク分解
    summarize: 0                      # 機械的な再要約
  # 全 assist リクエストに per-request で注入する chat_template_kwargs。
  # 上記 reasoning_budgets は本マップに自動マージされる。
  # - Qwen3 / Gemma-4 / DeepSeek-R1 等の thinking モデル: {"enable_thinking": false} (既定)
  #   jinja template が受理した場合に thinking を抑制する保険として機能。
  # - Llama 3 / Mistral 等の非 thinking モデル: {} を指定し、未知 kwarg
  #   送信を完全停止する。
  # ※ assist モデルの arch プロファイル reasoning.mode による能力ゲート:
  #   none   = enable_thinking / reasoning_budget を一切送らない (HTTP 400 回避)
  #   always = enable_thinking は送らない (OFF 不可) が reasoning_budget は送る (budget=0 で抑制可)
  #   toggle = 本設定どおり enable_thinking + reasoning_budget を送る
  chat_template_kwargs:
    enable_thinking: false

# ===== エディタ設定（Pro ワークモード）=====
editor:
  font_family: monospace            # フォントファミリー
  font_size: 14                     # フォントサイズ（8〜48）
  line_height: 1.5                  # 行高（1.0〜3.0）
  tab_size: 4                       # タブサイズ（1〜8）
  word_wrap: false                  # 折り返し
  show_line_numbers: true           # 行番号表示
  show_active_line: true            # アクティブ行ハイライト
  show_toolbar: true                # ツールバー表示
  default_encoding: utf-8           # デフォルトエンコーディング: utf-8 / shift_jis / euc-jp / iso-2022-jp
  default_line_ending: lf           # 改行コード: lf / crlf / cr
  highlight_languages:              # シンタックスハイライト対応言語
    - markdown
    - python
    - javascript
    - typescript
    - json
    - html
    - css
    - yaml
    - xml
    - sql
    - php

# ===== 自律ループ driver =====
# driver 骨組み、品質ゲートアダプタ
# (pytest / typecheck / lint) を実装済み。executor 接続 / failure_pattern /
# bootstrap / progress_marker は別層で接続する
loop:
  enabled: true
  driver: semmem_task                          # task ファクトを駆動源にする
  executor: ralph                              # ralph | noop
  max_iterations: 50                           # 1 セッションあたり最大イテレーション
  max_actions_per_task: 10                     # 1 task あたりの Action 実行上限
  max_wall_time_sec: 1800.0                    # started_at からの壁時間上限
  max_consecutive_failures: 3                  # 連続失敗で停止する閾値
  tick_interval_sec: 0.0                       # 各イテレーション後の sleep 秒 (0=即時)
  context_reset_threshold_tokens: 24000        # クリーンコンテキスト再起動のしきい値
  sleep_time_every_n: 5                        # N イテレーションごとに sleep-time partial run
  on_gate_fail: retry                          # retry | skip | abort
  retry_limit_per_task: 2                      # 失敗時の最大リトライ回数
  event_bus_max_queue: 128                     # SSE 進捗配信のキュー上限 (subscriber 単位)
  quality_gates:
    # 実装済み (backend/free/loop/quality_gate.py)
    # 失敗時はコミットせず、rollback_working_tree() で作業ツリーを破棄する。
    pytest: true                               # python scripts/safe_pytest.py
    typecheck: true                            # cd frontend && npm run check
    lint: false                                # cd frontend && npm run lint
  sandbox:
    # ラルフループのサンドボックス (ActionRunner)
    allowed_write_roots:                       # edit_file の書込先 allowlist
      - local/loop_sandbox
    allowed_commands:                          # run_command の先頭要素 allowlist
      - python
      - node
      - npm
      - git
    command_timeout_sec: 120.0

# ===== 長文生成設定 =====
# 長文生成エンジン。詳細は docs/f_09_long_form_engine.md 参照。
long_form:
  max_units: 20                     # 最大ユニット数
  unit_max_tokens: 2000             # ユニットあたり最大トークン数
  rolling_short_term_chars: 1000    # ローリング短期メモリの文字数
  review_enabled: true              # レビューフェーズの有効/無効
  max_revisions: 3                  # 最大修正回数（0=レビューのみ）
  document_quality_enabled: false   # TEXTのドキュメント出力(docx/pptx/xlsx/md)で構造ゲート(空/表の列ずれ/見出し階層/形式不適合)を重ね改稿。取得データは創作させず構造欠落のみ指摘。既定OFF
  repair_enabled: true              # 生成後の検証ゲート付きコードリペア(文法/未定義名の自動修正)
  max_repair_rounds: 2              # コードリペアの最大ラウンド数(0=無効)。Python は AST 厳密検証、他言語は assist 自己点検
  rag_per_unit: true                # ユニットごとにRAG検索を実行
  rag_top_k_per_unit: 3             # ユニットごとのRAG上位件数
  total_timeout_sec: 1800           # 1リクエストの総時間上限(秒)。0=無効。超過時は生成済みユニットで部分結果打ち切り
  code_spec_enabled: true           # コード生成前に共有設計仕様(contract)を合成し全ユニットに注入 + SPEC.md 出力
  code_flowchart_enabled: false     # 設計仕様から mermaid フローチャートを合成し SPEC.md に埋込(既定OFF)
  code_smoke_test_enabled: true     # 生成物の import スモークテスト(ModuleNotFoundError/dataclass引数違い等の実行時エラー捕捉)
  code_smoke_timeout_sec: 10        # import スモークテストのサブプロセスタイムアウト(秒)

# ===== コーディングモード パイプライン設定 =====
# pipeline=staged で「仕様書→コード→テスト」の多段・各工程多パス生成 (専用 LoopDriver を
# インライン駆動)。staged は Pro 限定 (evoref code は Pro ゲート済) かつ assist 健全時のみ起動。
# 既定 longform は従来の LongFormOrchestrator 1 リクエスト生成 (無改変)。
coding:
  pipeline: longform                  # staged | longform (既定 longform)
  staged_enabled: true                # staged のキルスイッチ (pipeline と独立。false で即無効化)
  staged:
    test_stage_enabled: true          # test 工程のうち advisory ユニットテスト生成+pytest 実行。false で生成のみ
    smoke_gate_enabled: true          # test 工程のうち決定論的 import スモーク+spec/flowchart 注入リペア。test_stage_enabled とは独立
    flowchart_enabled: true          # spec 工程でフロー構造を合成し flowchart.md (mermaid) と spec.md の Processing flow 節を同一データから描画
    flow_part_synthesis_enabled: false # flow_spec_synthesis が2回とも検証不合格の場合、Component/モジュール単位で部分合成→決定論結合するエスカレーション (既定OFF、fallback_flow へ直接縮退)
    max_repair_rounds: 2              # test 失敗時のリペア最大回数 (0-5)
    max_test_regen_rounds: 2         # test が src の実 API に不整合な時 test のみ再生成 (src 不変・準ゲート, 0-5)
    entry_smoke_exec_enabled: true   # エントリ有界実行スモーク (advisory)。false で静的検査のみ
    entry_smoke_timeout_sec: 10.0    # エントリ有界実行スモークのタイムアウト
    spec_max_tokens: 6144            # spec.md 生成の最大トークン上限 (Signature/Attributes/Behavior/Constants の詳細度を賄う。切断リトライ抑制)
    spec_deepen_enabled: true        # モジュール節を 1 節 1 呼出で実装水準 (メソッド毎挙動・属性・定数) まで深化 (棄却時は原節維持)
    spec_conformance_enabled: true   # spec 宣言契約と生成コードの決定論照合を smoke gate に合流 (false で観測のみ)
    code_max_tokens: 4096            # code 工程 (単一ファイル直接生成) の最大トークン。切断時のみ倍に広げ再生成
    spec_timeout_sec: 600.0          # spec 工程タイムアウト (spec 生成/節深化 共用。明示指定のため反応的較正より優先)
    test_timeout_sec: 120.0          # 生成テストの pytest サブプロセスタイムアウト
    total_timeout_sec: 2400.0        # staged 1 リクエスト全体のウォールクロック上限 (spec 深化 + フロー詳細化の増分込み)
    max_iterations: 60               # 専用 LoopDriver の最大イテレーション (≈ 1 + 2*モジュール数)
    cleanup_workspace: false         # 完了時に temp ワークスペースを削除 (false=継続/デバッグ用に保持)
    part_generation_enabled: false   # code 工程をコンポーネント部分生成→決定論結合で行う (spec 構造がある時のみ発動、無ければ単発へ自動フォールバック)
    part_max_tokens: 1536            # 部分 1 個の生成 max_tokens。切断時のみ倍に広げ再生成
    part_max_parts: 4                # 1 ファイルの最大部分数 (超過 component は spec 順に決定論併合)
    max_spec_revision_rounds: 1      # test 不合格時の spec 見直しサイクル上限 (ワークスペース全体, 0 で無効)

# ──────────────────────────────────────────────────────────────────────
# Pro 専用機能
# ──────────────────────────────────────────────────────────────────────
# - terminal: Pro 限定 Web ターミナル (PTY + xterm.js)
#   * enabled=true で /api/terminal/* + /terminal ページが利用可能
#   * セキュリティ 4 重ガード (Origin / Host / token / 127.0.0.1 bind 強制)
#   * server.host=0.0.0.0 + enabled=true は起動エラーで拒否される
#   * POSIX / Windows 両対応:
#     POSIX は ptyprocess、Windows は pywinpty (ConPTY) を OS 別に利用
#   * shell=auto:
#       POSIX → $SHELL → bash → zsh → sh
#       Windows → pwsh.exe → powershell.exe → cmd.exe
#   * agent_write_enabled=true でエージェント
#     からの PTY 書込を有効化。LLM 生成文字列を shell に渡すため攻撃面が
#     大きい — 既定は false、有効化時は allowlist + dangerous pattern + 監査
#     ログの 3 重ガードで保護される
pro:
  terminal:
    enabled: false                     # Pro 限定。既定無効
    shell: auto                        # auto | bash | pwsh | powershell | zsh | sh | cmd
    allowed_origins:
      - http://127.0.0.1:5173
      - http://localhost:5173
    max_sessions: 4                    # 同時セッション数の上限
    idle_timeout_sec: 1800             # idle 検出時 SIGTERM までの秒数
    token_ttl_sec: 60                  # POST /session で発行する token の TTL
    # エージェント主導の PTY 書込
    agent_write_enabled: false         # 既定無効。有効化時は LLM が任意のコマンドを shell に渡せる
    agent_command_allowlist: []        # 正規表現リスト。空=全許可、1 件以上指定でホワイトリスト方式
    agent_read_timeout_sec: 10         # terminal_exec の結果読取り最大秒数
  url_recall:
    # Pro 限定: ToolCallJudge の URL リコールに team プロファイルを追加で
    # 引き当て対象に含める。Free build では設定しても効果なし (起動時に WARNING)。
    team_profile_ids: []               # 例: ["team:default"] で team profile の URL fact も読込候補に
